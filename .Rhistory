## ── 4.6 Campo espacial estructurado (BYM2: uᵢ) ────────────────────────────
# Extraer efecto espacial estructurado (id_poly = uᵢ)
ran_spat <- fit_bym2$summary.random$id_poly
# Asignar media posterior y desviación estándar a los polígonos válidos
modelo_sf$u_mean <- NA_real_
modelo_sf$u_sd   <- NA_real_
modelo_sf$u_mean[keep_log] <- ran_spat$mean
modelo_sf$u_sd  [keep_log] <- ran_spat$sd
# Mapa de media posterior uᵢ
p_u_mean <- ggplot(modelo_sf) +
geom_sf(aes(fill = u_mean), color = NA) +
scale_fill_viridis_c(option = "magma", direction = -1) +
labs(title = "Campo espacial estructurado uᵢ – media posterior", fill = "mean(u)") +
theme_minimal()
# Mapa de incertidumbre (sd posterior)
p_u_sd <- ggplot(modelo_sf) +
geom_sf(aes(fill = u_sd), color = NA) +
scale_fill_viridis_c(option = "magma", direction = -1) +
labs(title = "Incertidumbre del campo uᵢ – desviación estándar", fill = "sd(u)") +
theme_minimal()
# Mostrar ambos mapas
p_u_mean
p_u_sd
## ── Visualización de densidades posteriores de coeficientes βₖ ─────────────
library(ggplot2)
library(tidyr)
library(purrr)
# Extraer distribuciones marginales de los efectos fijos
marginales_beta <- fit_bym2$marginals.fixed
# Convertir cada marginal a tibble con su nombre
densidades_beta <- purrr::imap_dfr(marginales_beta, ~{
as.data.frame(.x) |>
tibble::as_tibble() |>
dplyr::rename(beta = x, densidad = y) |>
dplyr::mutate(covariable = .y)
})
# Graficar todas las densidades en facets
ggplot(densidades_beta, aes(x = beta, y = densidad)) +
geom_line(color = "steelblue", size = 1) +
facet_wrap(~ covariable, scales = "free", ncol = 3) +
labs(
title = "Distribuciones posteriores de los coeficientes βₖ",
x = "Valor de β",
y = "Densidad posterior"
) +
theme_minimal(base_size = 13)
