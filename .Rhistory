# 1. Tabla con resumen de efectos aleatorios por era
era_tab <- fit_bym2$summary.random$era_geo |>
dplyr::select(ID, mean, `0.025quant`, `0.975quant`) |>
dplyr::rename(
era = ID,
media = mean,
IC_inf = `0.025quant`,
IC_sup = `0.975quant`
)
# 2. Visualización tipo forest plot
library(ggplot2)
ggplot(era_tab, aes(x = media, y = era)) +
geom_point(size = 2) +
geom_errorbarh(aes(xmin = IC_inf, xmax = IC_sup), height = 0.2) +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray50") +
labs(
title = "Efectos aleatorios por era geológica",
x = "Desviación respecto al nivel base (media ± IC 95%)",
y = "Era geológica"
) +
theme_minimal(base_size = 13)
