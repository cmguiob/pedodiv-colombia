patchwork::plot_layout(guides = "auto")
ggsave(
here::here("Figures", "lisa_tripanel_standardised.png"),
plot   = p_lisa_tripanel,
width  = 15, height = 5, dpi = 350          # 350 dpi como solicitaste
)
p_lisa_tripanel   # se muestra en el cuaderno
head(nb_queen)
##  DIAGNÓSTICO DEL GRADO  -----------------------------------------------------
grado_vec <- spdep::card(nb_queen)  # número de vecinos por polígono
#  Polígonos sin vecinos (debería ser 0 si el shapefile es consistente)
sin_vecinos <- which(grado_vec == 0)
message("Polígonos sin vecinos: ", length(sin_vecinos))  # ≈ 0 cuando todo ok
#  Polígonos “hiper-vecinos”  → p.ej. ríos / geoms. lineales
p99   <- quantile(grado_vec, 0.99)  # umbral percentil 99
hiper <- which(grado_vec > p99)
message("Polígonos con grado > p99 (", round(p99), "): ", length(hiper))
## ── 1 · Sub-vecindad sin islas ─────────────────────────────────────────────
# keep_log → vector lógico que filtra polígonos con datos válidos y ≥1 vecino
nb_sub <- spdep::subset.nb(nb_queen, subset = keep_log)
if (any(spdep::card(nb_sub) == 0)) stop("aún quedan polígonos sin vecinos")
## ── 2 · Matriz de adyacencia binaria (estilo = "B") ────────────────────────
# Se usa estilo "B" para que INLA la interprete como matriz simétrica binaria
A_bin <- spdep::nb2mat(nb_sub, style = "B", zero.policy = TRUE)
## ── 3 · Archivo .graph compatible con INLA ─────────────────────────────────
# Esta es la opción recomendada para estructuras grandes: INLA lee directamente
# el archivo .graph generado desde la lista de vecinos.
queen_graph <- "queen_sub.graph"
INLA::nb2INLA(file = queen_graph, nb = nb_sub)  # guarda el grafo en disco
# el archivo .graph generado desde la lista de vecinos.
queen_graph <- "queen_sub.graph"
spdep::nb2INLA(file = queen_graph, nb = nb_sub)  # guarda el grafo en disco
## ── 4 · Índice poligonal para efectos espaciales ───────────────────────────
# Se crea un índice numérico secuencial dentro del subconjunto válido (1...n)
modelo_sf$id_poly <- NA_integer_
modelo_sf$id_poly[keep_log] <- seq_len(sum(keep_log))
formula_bym2 <- log_Qdens ~
dem_media_z + pendiente_media_z +
lst_media_z + precip_media_z +
log_dem_cv_z + log_pendiente_cv_z +
log_lst_cv_temporal_z + log_precip_cv_temporal_z +
f(era_geo, model = "iid") +
f(id_poly, model = "bym2", graph = queen_graph, scale.model = TRUE)
fit_bym2 <- INLA::inla(
formula = formula_bym2,
data    = as.data.frame(modelo_sf)[keep_log, ],
family  = "gaussian",
control.predictor = list(compute = TRUE),
control.compute   = list(dic = TRUE, waic = TRUE)
)
## ── Fórmula sin estructura espacial ────────────────────────────────────────
# El modelo mantiene los mismos efectos fijos y el intercepto por era,
# pero omite el efecto BYM2 sobre id_poly. Este será el modelo de referencia.
formula_noesp <- log_Qdens ~
dem_media_z + pendiente_media_z +
lst_media_z + precip_media_z +
log_dem_cv_z + log_pendiente_cv_z +
log_lst_cv_temporal_z + log_precip_cv_temporal_z +
f(era_geo, model = "iid")
## ── Ajuste con INLA ────────────────────────────────────────────────────────
# Se mantienen los mismos argumentos para comparabilidad (datos, control.predictor, control.compute)
fit_noesp <- INLA::inla(
formula = formula_noesp,
data    = as.data.frame(modelo_sf)[keep_log, ],
family  = "gaussian",
control.predictor = list(compute = TRUE),
control.compute   = list(dic = TRUE, waic = TRUE, config = TRUE)
)
## ── Fórmula con estructura BYM2 pero sin efecto por era ────────────────────
formula_bym2_noera <- log_Qdens ~
dem_media_z + pendiente_media_z +
lst_media_z + precip_media_z +
log_dem_cv_z + log_pendiente_cv_z +
log_lst_cv_temporal_z + log_precip_cv_temporal_z +
f(id_poly, model = "bym2", graph = queen_graph, scale.model = TRUE)
## ── Ajuste con INLA ────────────────────────────────────────────────────────
fit_bym2_noera <- INLA::inla(
formula = formula_bym2_noera,
data    = as.data.frame(modelo_sf)[keep_log, ],
family  = "gaussian",
control.predictor = list(compute = TRUE),
control.compute   = list(dic = TRUE, waic = TRUE, config = TRUE)
)
summary(fit_bym2)
summary(fit_noesp)
## ── Fórmula con estructura BYM2 pero sin efecto por era ────────────────────
formula_bym2_noera <- log_Qdens ~
dem_media_z + pendiente_media_z +
lst_media_z + precip_media_z +
log_dem_cv_z + log_pendiente_cv_z +
log_lst_cv_temporal_z + log_precip_cv_temporal_z +
f(id_poly, model = "bym2", graph = queen_graph, scale.model = TRUE)
## ── Ajuste con INLA ────────────────────────────────────────────────────────
fit_bym2_noera <- INLA::inla(
formula = formula_bym2_noera,
data    = as.data.frame(modelo_sf)[keep_log, ],
family  = "gaussian",
control.predictor = list(compute = TRUE),
control.compute   = list(dic = TRUE, waic = TRUE, config = TRUE)
)
## ── Fórmula con estructura BYM2 pero sin efecto por era ────────────────────
formula_bym2_noera <- log_Qdens ~
dem_media_z + pendiente_media_z +
lst_media_z + precip_media_z +
log_dem_cv_z + log_pendiente_cv_z +
log_lst_cv_temporal_z + log_precip_cv_temporal_z +
f(id_poly, model = "bym2", graph = queen_graph, scale.model = TRUE)
## ── Ajuste con INLA ────────────────────────────────────────────────────────
fit_bym2_noera <- INLA::inla(
formula = formula_bym2_noera,
data    = as.data.frame(modelo_sf)[keep_log, ],
family  = "gaussian",
control.predictor = list(compute = TRUE),
control.compute   = list(dic = TRUE, waic = TRUE, config = TRUE)
)
summary(fit_bym2_noera)
## ── Extracción de métricas de ajuste ───────────────────────────────────────
tabla_modelos <- tibble::tibble(
Modelo = c("BYM2 completo", "BYM2 sin era", "Sin estructura espacial"),
DIC    = c(fit_bym2$dic$dic,
fit_bym2_noera$dic$dic,
fit_noesp$dic$dic),
WAIC   = c(fit_bym2$waic$waic,
fit_bym2_noera$waic$waic,
fit_noesp$waic$waic),
logML  = c(fit_bym2$mlik[1],
fit_bym2_noera$mlik[1],
fit_noesp$mlik[1])
)
tabla_modelos
tabla_modelos
## ── Forest plot comparativo de efectos fijos ───────────────────────────────
# Función auxiliar para extraer resumen de betas
extraer_betas <- function(fit, modelo_label) {
fit$summary.fixed |>
tibble::rownames_to_column("covariable") |>
dplyr::mutate(modelo = modelo_label) |>
dplyr::select(modelo, covariable, mean, `0.025quant`, `0.975quant`)
}
# Unir betas de los tres modelos
betas_comparados <- dplyr::bind_rows(
extraer_betas(fit_bym2, "BYM2 completo"),
extraer_betas(fit_bym2_noera, "BYM2 sin era"),
extraer_betas(fit_noesp, "Sin estructura espacial")
)
# Visualización tipo forest plot
library(ggplot2)
library(ggdist)
ggplot(betas_comparados, aes(x = mean, y = covariable, xmin = `0.025quant`, xmax = `0.975quant`, color = modelo)) +
geom_point(position = position_dodge(width = 0.6), size = 2) +
geom_errorbar(position = position_dodge(width = 0.6), width = 0.25) +
facet_wrap(~modelo) +
labs(x = "Efecto posterior (media ± IC 95%)", y = "Covariable", title = "Comparación de coeficientes fijos entre modelos") +
theme_minimal(base_size = 13)
84700 - 77200
## ── Forest plot comparativo de efectos fijos (único panel) ─────────────────
# Asegurar orden consistente de covariables
betas_comparados$covariable <- factor(
betas_comparados$covariable,
levels = rev(unique(betas_comparados$covariable))
)
ggplot(betas_comparados, aes(
x = mean,
y = covariable,
xmin = `0.025quant`,
xmax = `0.975quant`,
color = modelo
)) +
geom_point(position = position_dodge(width = 0.5), size = 2) +
geom_errorbar(position = position_dodge(width = 0.5), width = 0.2) +
labs(
title = "Comparación de efectos fijos entre modelos (IC 95%)",
x = "Media posterior",
y = "Covariable"
) +
theme_minimal(base_size = 13) +
theme(legend.position = "bottom")
## ── Tabla comparativa de efectos fijos entre modelos ───────────────────────
# Función auxiliar para extraer coeficientes
extraer_betas <- function(fit, modelo_label) {
fit$summary.fixed |>
tibble::rownames_to_column("covariable") |>
dplyr::mutate(modelo = modelo_label) |>
dplyr::select(modelo, covariable, mean, `0.025quant`, `0.975quant`)
}
# Unir betas de los tres modelos
betas_all <- dplyr::bind_rows(
extraer_betas(fit_bym2, "BYM2 completo"),
extraer_betas(fit_bym2_noera, "BYM2 sin era"),
extraer_betas(fit_noesp, "Sin estructura espacial")
)
# Tabla ancha para comparación entre modelos
tabla_betas <- betas_all |>
tidyr::pivot_wider(
names_from = modelo,
values_from = c(mean, `0.025quant`, `0.975quant`)
) |>
dplyr::mutate(
diferencia_relativa_pct = 100 * (mean_BYM2_completo - mean_Sin_estructura_espacial) / abs(mean_Sin_estructura_espacial)
) |>
dplyr::rename_with(~gsub("mean_", "media_", .x)) |>
dplyr::rename_with(~gsub("0.025quant_", "IC_inf_", .x)) |>
dplyr::rename_with(~gsub("0.975quant_", "IC_sup_", .x)) |>
dplyr::mutate(diferencia_relativa_pct = round(diferencia_relativa_pct, 1))
## ── Tabla comparativa simplificada de efectos fijos ────────────────────────
# Función auxiliar para extraer resumen de betas
extraer_betas <- function(fit, modelo_label) {
fit$summary.fixed |>
tibble::rownames_to_column("covariable") |>
dplyr::mutate(modelo = modelo_label) |>
dplyr::select(modelo, covariable, mean, `0.025quant`, `0.975quant`)
}
# Combinar betas de los tres modelos
betas_all <- dplyr::bind_rows(
extraer_betas(fit_bym2, "BYM2 completo"),
extraer_betas(fit_bym2_noera, "BYM2 sin era"),
extraer_betas(fit_noesp, "Sin estructura espacial")
)
# Convertir a formato ancho: una fila por covariable
tabla_betas_simple <- betas_all |>
tidyr::pivot_wider(
names_from = modelo,
values_from = c(mean, `0.025quant`, `0.975quant`)
)
# Mostrar tabla
print(tabla_betas_simple, n = Inf)
tabla_betas_simple
tabla_betas_simple[,5:9]
## ── Visualización de hiperparámetros del campo espacial ───────────────────
# Función para extraer phi y varianza del campo BYM2
extraer_hiperparam <- function(fit, modelo_label) {
# Extrae phi y precision (si están disponibles)
hpars <- fit$summary.hyperpar
tibble::tibble(
modelo = modelo_label,
phi = hpars[grepl("Phi", rownames(hpars)), "mean"],
prec = hpars[grepl("Precision.*id_poly", rownames(hpars)), "mean"]
) |>
dplyr::mutate(varianza = 1 / prec)
}
# Aplicar a los modelos que tienen estructura espacial
hipers <- dplyr::bind_rows(
extraer_hiperparam(fit_bym2, "BYM2 completo"),
extraer_hiperparam(fit_bym2_noera, "BYM2 sin era")
)
# Transformar a formato largo
hipers_largo <- hipers |>
tidyr::pivot_longer(cols = c(phi, varianza), names_to = "parametro", values_to = "valor")
# Graficar
ggplot(hipers_largo, aes(x = parametro, y = valor, fill = modelo)) +
geom_col(position = position_dodge(width = 0.6), width = 0.5) +
geom_text(aes(label = round(valor, 2)), position = position_dodge(width = 0.6), vjust = -0.5, size = 3.5) +
scale_y_continuous(expand = expansion(mult = c(0, 0.1))) +
labs(
title = "Comparación de hiperparámetros del campo espacial",
x = "Parámetro",
y = "Valor estimado (posterior media)"
) +
theme_minimal(base_size = 13) +
theme(legend.position = "bottom")
## ── Tabla comparativa de hiperparámetros ──────────────────────────────────
# Función para extraer hiperparámetros de cada modelo
extraer_hiperpar_completo <- function(fit, modelo_label) {
hpars <- fit$summary.hyperpar
phi <- hpars[grepl("Phi", rownames(hpars)), "mean"]
prec <- hpars[grepl("Precision.*id_poly", rownames(hpars)), "mean"]
prec_era <- hpars[grepl("Precision for era_geo", rownames(hpars)), "mean"]
tibble::tibble(
modelo = modelo_label,
phi = ifelse(length(phi) > 0, phi, NA),
prec = ifelse(length(prec) > 0, prec, NA),
varianza = ifelse(!is.na(prec), 1 / prec, NA),
prec_era = ifelse(length(prec_era) > 0, prec_era, NA),
varianza_era = ifelse(!is.na(prec_era), 1 / prec_era, NA)
)
}
# Aplicar a los modelos
tabla_hiper <- dplyr::bind_rows(
extraer_hiperpar_completo(fit_bym2, "BYM2 completo"),
extraer_hipe_
## ── Tabla comparativa de hiperparámetros ──────────────────────────────────
# Función para extraer hiperparámetros de cada modelo
extraer_hiperpar_completo <- function(fit, modelo_label) {
hpars <- fit$summary.hyperpar
phi <- hpars[grepl("Phi", rownames(hpars)), "mean"]
prec <- hpars[grepl("Precision.*id_poly", rownames(hpars)), "mean"]
prec_era <- hpars[grepl("Precision for era_geo", rownames(hpars)), "mean"]
tibble::tibble(
modelo = modelo_label,
phi = ifelse(length(phi) > 0, phi, NA),
prec = ifelse(length(prec) > 0, prec, NA),
varianza = ifelse(!is.na(prec), 1 / prec, NA),
prec_era = ifelse(length(prec_era) > 0, prec_era, NA),
varianza_era = ifelse(!is.na(prec_era), 1 / prec_era, NA)
)
}
# Aplicar a los modelos
tabla_hiper <- dplyr::bind_rows(
extraer_hiperpar_completo(fit_bym2, "BYM2 completo"),
extraer_hiperpar_completo(fit_bym2_noera, "BYM2 sin era"),
extraer_hiperpar_completo(fit_noesp, "Sin estructura espacial")
)
