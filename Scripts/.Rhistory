legend.direction = "horizontal", # Ensure it's horizontal
legend.justification = "left", # Justify the legend to the left
legend.title = element_blank())
ggsave(
filename = here::here("Figures", "forestplot_coeficientes.png"),
plot     = p_forest_coefs,
width    = 5,
height   = 6,
dpi      = 350
)
p_forest_coefs
## ── Extracción de coeficientes fijos por modelo ────────────────────────────
# Función auxiliar para extraer resumen de betas
extraer_betas <- function(fit, modelo_label) {
fit$summary.fixed |>
tibble::rownames_to_column("covariable") |>
dplyr::mutate(modelo = modelo_label) |>
dplyr::select(modelo, covariable, mean, `0.025quant`, `0.975quant`)
}
# Crear tabla unificada de coeficientes fijos
betas_comparados <- dplyr::bind_rows(
extraer_betas(fit_besag_sep,   "Espacial completo"),
extraer_betas(fit_besag_noera, "Espacial sin era"),
extraer_betas(fit_noesp,       "No espacial")
)
## ── Forest plot comparativo de efectos fijos con ajustes visuales ─────────
library(ggplot2)
# Paleta personalizada para los modelos
pal_modelos <- c(
"Espacial completo"  = "#EF5703FF",  # rojo
"Espacial sin era"        = "#E3B710FF",  # naranja
"No espacial"                = "#3A9AB2FF"   # azul
)
# Renombrar covariables para que sean más interpretables
nombres_covariables <- c(
"(Intercept)"                 = "Intercepto",
"dem_media_z"                = "Elevación media (z)",
"pendiente_media_z"          = "Pendiente media (z)",
"lst_media_z"                = "Temperatura media (z)",
"precip_media_z"             = "Precipitación media (z)",
"log_dem_cv_z"               = "CV elevación (log, z)",
"log_pendiente_cv_z"         = "CV pendiente (log, z)",
"log_lst_cv_temporal_z"      = "CV temperatura (log, z)",
"log_precip_cv_temporal_z"   = "CV precipitación (log, z)"
)
# Reasignar nombres legibles a la columna 'covariable'
betas_comparados$covariable <- factor(
betas_comparados$covariable,
levels = rev(names(nombres_covariables))
)
levels(betas_comparados$covariable) <- rev(unname(nombres_covariables))
# Graficar
p_forest_coefs <- ggplot(betas_comparados, aes(
x = mean,
y = covariable,
xmin = `0.025quant`,
xmax = `0.975quant`,
color = modelo
)) +
geom_point(position = position_dodge(width = 0.7), size = 2) +
geom_errorbar(position = position_dodge(width = 0.7), width = 0.25) +
labs(
title = "Coeficientes por modelo (media e IC 95 %)",
x = "Media posterior E[β | datos]",
y = NULL
) +
scale_color_manual(values = pal_modelos) +
theme_minimal(base_size = 13) +
theme(legend.position = "bottom",
legend.direction = "horizontal", # Ensure it's horizontal
legend.justification = "left", # Justify the legend to the left
legend.title = element_blank())
ggsave(
filename = here::here("Figures", "forestplot_coeficientes.png"),
plot     = p_forest_coefs,
width    = 5,
height   = 6,
dpi      = 350
)
p_forest_coefs
